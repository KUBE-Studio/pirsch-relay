# Copy to .env for local runs (scripts/local.mjs), or set the same variables
# in Vercel → Project → Settings → Environment Variables. After changing a
# variable on Vercel, redeploy — env vars only apply to new deployments.

# Required. Pirsch → dashboard settings → Integration → Access Keys.
# Create a key with write access. Never commit it.
PIRSCH_ACCESS_KEY=

# Required. Four paths on your relay subdomain. Pick your OWN, neutral values:
# no words like track, analytics, pirsch, hit, event, pageview. The same paths
# on many sites become a pattern that blocklists learn. They must match the
# data-*-endpoint attributes in snippet.html exactly, otherwise nothing is
# measured — silently. Generate a set with:
#   node -e "const r=()=>Math.random().toString(36).slice(2,6);console.log('/'+r()+'/'+r()+'.js','/'+r()+'/'+r(),'/'+r()+'/'+r(),'/'+r()+'/'+r())"
# Example shape (do not copy these values):
#   /static/q8vz/app.js  /q8vz/r2  /q8vz/t5  /q8vz/u7
RELAY_SCRIPT_PATH=
RELAY_HIT_PATH=
RELAY_EVENT_PATH=
RELAY_SESSION_PATH=

# Optional. Serve the event helper (lib/events.js) under this path.
# Leave empty to disable.
RELAY_EVENTS_SCRIPT_PATH=

# Optional. CORS origin, default "*". May be set to your site's origin,
# e.g. https://www.example.com
RELAY_ALLOWED_ORIGIN=

# Optional, for tests only. Upstream base URL, default https://api.pirsch.io
PIRSCH_BASE_URL=
